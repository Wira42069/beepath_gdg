# Copy to .env (git-ignored) and fill in what you need.

# Offline tagging (npm run tag). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Database. Leave empty for a local SQLite file in .data/ (development).
# For Vercel: create a Turso database and paste its URL and token here and in the Vercel project settings.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Which dataset the app serves: sample (default) or binus (after scrape -> import -> tag -> db:seed).
BEEPATH_DATASET=sample
